# MarketMind AI — Phase 0 Configuration Example
# Copy to .env if overriding defaults. Do not commit real secrets.

# Backend API settings
MARKETMIND_APP_NAME=MarketMind AI (Phase 0 Prototype)
MARKETMIND_ENV=prototype
MARKETMIND_API_PREFIX=/api/v1
MARKETMIND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MARKETMIND_PROTOTYPE_STORE_PATH=backend/data/prototype_store.json

# AI Provider Mode (Phase 0 defaults to clearly labelled demo/mock adapter)
MARKETMIND_AI_PROVIDER=mock_demo

# Frontend (Vite)
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
